modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "build-no-db"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "integration-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-drift"

[[workflows.workflow]]
name = "test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm -r --if-present run test"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "lint"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run lint"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "build-no-db"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/artwork-bank run build:no-db"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "integration-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/artwork-bank run test:integration"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DATABASE_URL=\"$PROD_DATABASE_URL\" pnpm --filter @workspace/db run check-drift"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
STRIPE_WEBHOOK_DEV_BYPASS = "true"

[userenv.shared]
PLATFORM_ADMIN_EMAILS = "jane@janesmith.studio"
SLACK_BILLING_ALERTS_CHANNEL = "#art-bank"

[objectStorage]
defaultBucketID = "replit-objstore-a3e01a9c-379d-4783-8b77-8b10f9a56d44"
