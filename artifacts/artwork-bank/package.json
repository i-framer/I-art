{
  "name": "@workspace/artwork-bank",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port $PORT",
    "build": "pnpm --filter @workspace/db run check-drift && next build",
    "build:no-db": "BUILD_DIR=.next-ci rm -rf .next-ci && BUILD_DIR=.next-ci env -u DATABASE_URL -u SESSION_SECRET next build",
    "start": "next start --port $PORT",
    "typecheck": "rm -rf .next/types && tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:slow": "vitest run --config vitest.slow.config.ts --no-file-parallelism --reporter=verbose",
    "test:integration": "node scripts/require-db.js && vitest run --no-file-parallelism --reporter=verbose integration",
    "db:seed": "tsx scripts/seed.ts",
    "smoke:billing-alert": "tsx scripts/smoke-billing-alert.ts",
    "smoke:schema-push-alert": "tsx scripts/smoke-schema-push-alert.ts",
    "smoke:drift-alert": "tsx scripts/smoke-drift-alert.ts",
    "probe:nextdev-startup": "tsx scripts/probe-nextdev-startup.ts"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "@types/pg": "^8.20.0",
    "@vercel/blob": "^2.7.0",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "catalog:",
    "iron-session": "^8.0.4",
    "lucide-react": "catalog:",
    "next": "^15.3.3",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.6",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
