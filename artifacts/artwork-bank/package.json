{
  "name": "@workspace/artwork-bank",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port $PORT",
    "build": "pnpm --filter @workspace/db run check-drift && next build",
    "build:no-db": "BUILD_DIR=.next-ci rm -rf .next-ci && BUILD_DIR=.next-ci env -u DATABASE_URL -u SESSION_SECRET next build",
    "start": "next start --port $PORT",
    "typecheck": "rm -rf .next/types && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/require-db.js && vitest run --reporter=verbose integration",
    "db:seed": "tsx scripts/seed.ts",
    "smoke:billing-alert": "tsx scripts/smoke-billing-alert.ts",
    "smoke:schema-push-alert": "tsx scripts/smoke-schema-push-alert.ts"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "@vercel/blob": "^2.6.1",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "catalog:",
    "iron-session": "^8.0.4",
    "lucide-react": "catalog:",
    "next": "^15.3.3",
    "nodemailer": "^9.0.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "^8.5.6",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
