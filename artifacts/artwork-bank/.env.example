# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (populated automatically in the Replit workspace)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Authentication ─────────────────────────────────────────────────────────────

# Secret used to sign iron-session cookies (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# ── Platform admin ─────────────────────────────────────────────────────────────

# Comma-separated list of email addresses that can access /platform (billing panel)
# Unset = nobody has access (fails closed)
PLATFORM_ADMIN_EMAILS=admin@example.com

# ── Stripe (optional — required for payment flows) ─────────────────────────────

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Set to "true" in development to bypass Stripe signature verification on the
# webhook endpoint (lets you POST raw JSON without the Stripe CLI)
STRIPE_WEBHOOK_DEV_BYPASS=true

# ── Email (optional — required for order/inquiry notifications) ─────────────────

RESEND_API_KEY=re_...
# Operator email that receives billing-alert notifications
PLATFORM_ADMIN_EMAIL=admin@example.com
# From-address used for all outgoing emails (must be a verified Resend sender domain)
EMAIL_FROM=noreply@example.com

# ── Slack billing alerts (optional) ────────────────────────────────────────────

# Target channel for billing-alert Slack messages.
# Format: channel name (e.g. #billing-alerts) or Slack channel ID (e.g. C0123456789).
# Leave unset to disable Slack alerts without breaking anything else.
# Requires the Slack OAuth connector to be set up in Replit Integrations.
SLACK_BILLING_ALERTS_CHANNEL=#billing-alerts

# ── Object storage ─────────────────────────────────────────────────────────────

# Vercel Blob (required on Vercel — create a Blob store in Vercel → Storage,
# then connect it to the project; the token is injected automatically).
# See DEPLOY.md §3 for full instructions.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Optional: pin the Blob store's public base URL to skip the one-time lookup.
# BLOB_BASE_URL=https://<store-id>.public.blob.vercel-storage.com

# Replit App Storage (populated automatically in the Replit dev workspace).
# These are NOT needed on Vercel.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=...
PRIVATE_OBJECT_DIR=...
PUBLIC_OBJECT_SEARCH_PATHS=...

# ── Deployment / URLs ──────────────────────────────────────────────────────────

# Override the public base URL (used for email links, OG tags, etc.)
# Only needed when automatic detection (VERCEL_URL, REPLIT_DOMAINS) is wrong
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
